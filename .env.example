# SynthArena Environment Variables
# Copy to .env and modify as needed

# ─── API Server ──────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── Authentication ──────────────────────────────────────────────
# Comma-separated API keys (simple mode, used when DATABASE_URL not set)
# API_KEYS=sk-dev-key-1,sk-dev-key-2

# ─── PostgreSQL (evaluation storage) ────────────────────────────
# When set, evaluations persist to PostgreSQL instead of in-memory
DATABASE_URL=postgresql://syntharena:syntharena@localhost:5432/syntharena

# ─── Redis (job queue + rate limiting) ───────────────────────────
# When set, enables async evaluation queue and distributed rate limiting
REDIS_URL=redis://localhost:6379

# ─── ClickHouse (traces + analytics) ────────────────────────────
# When set, enables trace storage and cost analytics
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=syntharena
CLICKHOUSE_PASSWORD=syntharena

# ─── LLM Provider Keys ──────────────────────────────────────────
# Required for LLM-as-judge graders and scenario generation
ANTHROPIC_API_KEY=

# ─── Rate Limiting ──────────────────────────────────────────────
# Default requests per minute per key (overridden by per-key DB setting)
RATE_LIMIT_MAX=100

# ─── OpenTelemetry ─────────────────────────────────────────────
# When set, enables trace export to OTLP-compatible backends (Jaeger, Datadog, etc.)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=syntharena-api

# ─── CORS ───────────────────────────────────────────────────────
# Comma-separated allowed origins
ALLOWED_ORIGINS=http://localhost:3000
