{
  "name": "syntharena",
  "version": "0.1.0",
  "description": "SynthArena TypeScript SDK - Pre-deployment agent simulation",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "dev": "tsc --watch",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "keywords": ["ai", "agents", "evaluation", "testing", "simulation", "synthetic-data", "llm", "benchmark"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/asquitt/synth-arena.git",
    "directory": "packages/sdk-ts"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@syntharena/core": "workspace:*",
    "@syntharena/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.0.0"
  }
}
