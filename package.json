{
  "name": "synth-arena",
  "version": "0.1.0",
  "private": true,
  "description": "Private internal agent-evaluation tooling; not a standalone product",
  "scripts": {
    "status:verify": "node scripts/verify-portfolio-status.mjs",
    "status:test": "node scripts/test-portfolio-status.mjs",
    "lab:dev": "turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "test:core": "turbo test --filter=@syntharena/core",
    "test:scenarios": "turbo test --filter=@syntharena/scenarios",
    "lab:cli": "pnpm --filter=@syntharena/cli exec synth-arena"
  },
  "devDependencies": {
    "turbo": "^2.4.0",
    "typescript": "^5.7.0"
  },
  "packageManager": "pnpm@9.15.0"
}
